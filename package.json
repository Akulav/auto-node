{
  "name": "autonode",
  "version": "1.0.3",
  "description": "A beautiful, simple control panel for hosting Node.js websites on your own Linux machine.",
  "type": "module",
  "bin": {
    "autonode": "bin/autonode.js"
  },
  "scripts": {
    "start": "node bin/autonode.js serve",
    "dev": "node bin/autonode.js serve --dev",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check-syntax.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "os": [
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Akulav/auto-node.git"
  },
  "author": "Akulav",
  "homepage": "https://github.com/Akulav/auto-node",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "bin",
    "src",
    "public",
    "install.sh"
  ]
}
